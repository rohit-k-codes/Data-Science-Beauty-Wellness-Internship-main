# =============================================
# Beauty & Wellness Skincare Project .gitignore
# =============================================

# --- Data files (do NOT commit raw data unless license permits) ---
data/raw/
data/processed/
*.csv
*.json
*.json.gz
*.parquet

# --- Credentials and secrets ---
.env
*.key
kaggle.json
secrets.json

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
venv/
env/
.venv/
*.egg-info/
dist/
build/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- OS files ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE ---
.vscode/
.idea/
*.swp
